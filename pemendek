from flask import Flask, request, redirect, render_template_string
import json
import os
import random
import string

app = Flask(__name__)
DATA_FILE = "urls.json"
BASE_URL = "http://localhost:5000/"

# HTML sederhana
HTML_FORM = '''
<!doctype html>
<title>URL Shortener</title>
<h2>Perpendek URL</h2>
<form method=post>
  <input type=text name=long_url placeholder="Masukkan URL panjang" required style="width: 300px;">
  <input type=submit value=Shorten>
</form>
{% if short_url %}
  <p>URL pendek: <a href="{{ short_url }}">{{ short_url }}</a></p>
{% endif %}
'''

def load_data():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r") as file:
            return json.load(file)
    else:
        return {}

def save_data(data):
    with open(DATA_FILE, "w") as file:
        json.dump(data, file, indent=4)

def generate_short_code(length=6):
    return ''.join(random.choices(string.ascii_letters + string.digits, k=length))

@app.route('/', methods=['GET', 'POST'])
def index():
    short_url = None
    if request.method == 'POST':
        long_url = request.form['long_url']
        data = load_data()

        # Cek apakah URL sudah ada
        for code, url in data.items():
            if url == long_url:
                short_url = BASE_URL + code
                break
        else:
            # Generate unik
            while True:
                code = generate_short_code()
                if code not in data:
                    break
            data[code] = long_url
            save_data(data)
            short_url = BASE_URL + code

    return render_template_string(HTML_FORM, short_url=short_url)

@app.route('/<code>')
def redirect_to_long_url(code):
    data = load_data()
    long_url = data.get(code)
    if long_url:
        return redirect(long_url)
    else:
        return "URL tidak ditemukan.", 404

if __name__ == '__main__':
    app.run(debug=True)
